[t:template,n:2W_copter_base]  // = 2W_copter
{
	category_name = "2W_evil_d";
	doc = "2W_robot_copter";
	specializes = actor_evil;
	[actor]
	{
		[skills]
		{
			strength =  	7.9, 0;
			intelligence =  	7.9, 0;
			dexterity =  	20.1, 0;
			ranged =  	58,  0;
		}
	}
	[aspect]
	{
		experience_value = 72007;
		life = 745.2;
		max_life = 745.2;
		mana = 248.4;
		max_mana = 248.4;
		model = m_c_edm_cp_pos_1;
		material = wood;
		[voice]
		{
			[die]			{ priority = high; * = s_e_die_copter; }
			[enemy_spotted]	{ priority = high; * = s_e_call_mechanoid_small_SED;	}
		}
	}
	[attack]
	{
		attack_range = 	0.5;
		damage_max = 	265;
		damage_min = 	207.9;
		damage_bonus_min_cmagic = 110;
		damage_bonus_max_cmagic = 144;
	}
	[body]
	{
		min_move_velocity = 3.75;
		avg_move_velocity = 5.990000;
		[bone_translator]
		{
			body_anterior = bone01;
			body_mid = bone01;
			body_posterior = bone01;
			kill_bone = bone01;
			shield_bone = bone01;
			weapon_bone = bone01;
		}
		[chore_dictionary]
		{
			chore_prefix = a_c_edm_cp_fs;
			[chore_attack]
			{
				chore_stances = 0;
				skrit = select_attack;
				[anim_files] { 00=at; }
			}
			[chore_default]
			{
				chore_stances = 0;
				skrit = infinite_loop;
				[anim_files] { 00=ds; }
			}
			[chore_die]
			{
				chore_stances = 0;
				skrit = select_transition;
				[anim_files] { 00=dsf; }
			}
			[chore_fidget]
			{
				chore_stances = 0;
				skrit = select_fidget;
				[anim_files] { 00=fl; }
			}
			[chore_magic]
			{
				chore_stances = 0;
				skrit = select_transition;
				[anim_files] { 00=at; }
			}
			[chore_walk]
			{
				chore_stances = 0;
				skrit = select_walk;
				[anim_files] { 00=fl; }
			}
		}
	}

	[inventory]
	{
		selected_active_location = il_active_primary_spell;
		[other] { il_active_primary_spell=spell_copter_lightning; }
	}

	[common]
	{
		screen_name="Copter";
		[template_triggers]
		{
			[*]
			{
				condition* = receive_world_message("WE_ENTERED_WORLD");
				single_shot = true;
				action* = call_sfx_script("tailpipe_steam_copter");

			}
		}
	}
	[defend] { defense=511.7; }
	[mind]
	{
		actor_weapon_preference			= WP_MAGIC;
		actor_auto_switches_to_magic	= true;
		actor_auto_switches_to_karate	= false;
		actor_auto_switches_to_melee	= false;

		melee_engage_range = 12;
		personal_space_range = 0.7;
		ranged_engage_range = 13.0;
		sight_range = 14.0;
	}
	[physics]
	{
		break_effect = generic_explosion;
		explode_when_killed = true;
		explosion_magnitude = 3.0;
		gib_gore_good = true;
		[break_particulate]
		{
			frag_glb_copter_01 = 1;
			frag_glb_copter_02 = 1;
			frag_glb_copter_03 = 1;
			frag_glb_copter_04 = 1;
			frag_glb_copter_05 = 1;
			frag_glb_metal_01 = 1;
			frag_glb_metal_03 = 1;
			frag_glb_metal_04 = 1;
			frag_glb_metal_05 = 2;
			frag_glb_metal_06 = 2;
			frag_glb_wood_01 = 1;
			frag_glb_wood_02 = 1;
			frag_glb_wood_03 = 1;
			frag_glb_wood_04 = 2;
			frag_glb_wood_05 = 2;
			frag_glb_wood_06 = 3;
		}
	}
}

[t:template,n:2W_copter_large] { specializes = 2W_copter_large_base; }
[t:template,n:2W_copter_large_base]
{
	specializes = 2W_copter_base;

	common:screen_name = "Large Copter";
	aspect:scale_base = 1.5;
	[physics]
	{
		[break_particulate]
		{
			frag_glb_copter_large_01 = 1;
			frag_glb_copter_large_02 = 1;
			frag_glb_copter_large_03 = 1;
			frag_glb_copter_large_04 = 1;
			frag_glb_copter_large_05 = 1;
			frag_glb_metal_large_01 = 1;
			frag_glb_metal_large_03 = 1;
			frag_glb_metal_large_04 = 1;
			frag_glb_metal_large_05 = 2;
			frag_glb_metal_large_06 = 2;
			frag_glb_wood_large_01 = 1;
			frag_glb_wood_large_02 = 1;
			frag_glb_wood_large_03 = 1;
			frag_glb_wood_large_04 = 2;
			frag_glb_wood_large_05 = 2;
			frag_glb_wood_large_06 = 3;
		}
	}

	// balancing
	// values same
	[actor]
	{
		[skills]
		{
			strength =  	7.9, 0;
			intelligence =  	7.9, 0;
			dexterity =  	20.1, 0;
			ranged =  	58,  0;
		}
	}
	// values roughly *= 1.5
	[aspect]
	{
		experience_value = 110000;
		life = 1000;
		max_life = 1000;
		mana = 350;
		max_mana = 350;
	}
	[attack]
	{
		damage_max = 	400;
		damage_min = 	300;
		damage_bonus_min_cmagic = 165;
		damage_bonus_max_cmagic = 216;
	}
	[defend] { defense=767; }
}

[t:template,n:2W_copter_boss_01]
{
	specializes = 2W_copter_large_base;

	[common]
	{
		membership = monster,immune_charm,immune_control,immune_freeze,immune_polymorph,immune_align_change,immune_explode;
		screen_name = "Copter Ballista";
		[template_triggers]
		{
			// existing
			[*]
			{
				condition* = receive_world_message("WE_ENTERED_WORLD");
				single_shot = true;
				action* = call_sfx_script("tailpipe_steam_copter");
			}
			// added
			[*]
			{
				condition* = receive_world_message("WE_ENTERED_WORLD");
				single_shot = true;
				no_trig_bits = true;
				action* = call_sfx_script("unique_ray_purple(sgx)");
			}
		}
	}

	// balancing
	// values same
	[actor]
	{
		[skills]
		{
			strength =  	7.9, 0;
			intelligence =  	7.9, 0;
			dexterity =  	20.1, 0;
			ranged =  	58,  0;
		}
	}
	// values roughly doubled
	[aspect]
	{
		experience_value = 144000;
		life = 1500;
		max_life = 1500;
		mana = 500;
		max_mana = 500;
	}
	[attack]
	{
		damage_max = 	530;
		damage_min = 	416;
		damage_bonus_min_cmagic = 220;
		damage_bonus_max_cmagic = 288;
	}
	[defend] { defense=1000; }
	// loot from 2W_swamp_creature_boss_01
   	[inventory]
	{
    	[pcontent]
		{
			[oneof*]
			{
				[oneof*]
				{
					chance = 0.794;
					il_main = #*/205-219;
					il_main = #armor/708-806;
	                il_main = #weapon/205-219;
				}
				[oneof*]
				{
	            	chance = 0.004;
	                il_main = #weapon/-rare(1)/224-262;
	                il_main = #armor/-rare(1)/739-861;
                    il_main = #*/-rare(1)/224-262;
                }
				[oneof*]
				{
                	chance = 0.002;
	                il_main = #weapon/-unique(2)/224-262;
	                il_main = #armor/-unique(2)/739-861;
                    il_main = #*/-unique(2)/224-262;
	            }
				[gold*]
				{
					chance = 0.2;
					max = 173209;
					min = 82270;
					min_pile = 225;
					piles = 5 - 7;
				}
			}
		}
	}
}
